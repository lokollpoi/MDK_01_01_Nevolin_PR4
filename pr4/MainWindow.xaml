<Window x:Class="pr4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr4"
        mc:Ignorable="d"
        Title="Шахматы" Height="450" Width="800">
    <Grid>
        <Grid x:Name="gameBoard" Width="400" Height="400">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 0 -->
            <Grid Background="White" Width="50" Height="50" Grid.Column="0" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="2" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="4" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="6" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" MouseDown="SelectTile"/>

            <!-- 1 -->
            <Grid Background="White" Width="50" Height="50" Grid.Column="1" Grid.Row="1" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="3" Grid.Row="1" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="5" Grid.Row="1" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="7" Grid.Row="1" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="0" Grid.Row="1" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="2" Grid.Row="1" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="4" Grid.Row="1" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="6" Grid.Row="1" MouseDown="SelectTile"/>

            <!-- 2 -->
            <Grid Background="White" Width="50" Height="50" Grid.Column="0" Grid.Row="2" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="2" Grid.Row="2" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="4" Grid.Row="2" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="6" Grid.Row="2" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" Grid.Row="2" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" Grid.Row="2" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" Grid.Row="2" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" Grid.Row="2" MouseDown="SelectTile"/>

            <!-- 3 -->
            <Grid Background="White" Width="50" Height="50" Grid.Column="1" Grid.Row="3" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="3" Grid.Row="3" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="5" Grid.Row="3" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="7" Grid.Row="3" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="0" Grid.Row="3" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="2" Grid.Row="3" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="4" Grid.Row="3" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="6" Grid.Row="3" MouseDown="SelectTile"/>

            <!-- 4 -->
            <Grid Background="White" Width="50" Height="50" Grid.Column="0" Grid.Row="4" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="2" Grid.Row="4" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="4" Grid.Row="4" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="6" Grid.Row="4" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" Grid.Row="4" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" Grid.Row="4" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" Grid.Row="4" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" Grid.Row="4" MouseDown="SelectTile"/>

            <!-- 5 -->
            <Grid Background="White" Width="50" Height="50" Grid.Column="1" Grid.Row="5" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="3" Grid.Row="5" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="5" Grid.Row="5" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="7" Grid.Row="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="0" Grid.Row="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="2" Grid.Row="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="4" Grid.Row="5" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="6" Grid.Row="5" MouseDown="SelectTile"/>

            <!-- 6 -->
            <Grid Background="White" Width="50" Height="50" Grid.Column="0" Grid.Row="6" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="2" Grid.Row="6" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="4" Grid.Row="6" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="6" Grid.Row="6" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" Grid.Row="6" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" Grid.Row="6" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" Grid.Row="6" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" Grid.Row="6" MouseDown="SelectTile"/>

            <!--7 -->
            <Grid Background="White" Width="50" Height="50" Grid.Column="1" Grid.Row="7" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="3" Grid.Row="7" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="5" Grid.Row="7" MouseDown="SelectTile"/>
            <Grid Background="White" Width="50" Height="50" Grid.Column="7" Grid.Row="7" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="0" Grid.Row="7" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="2" Grid.Row="7" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="4" Grid.Row="7" MouseDown="SelectTile"/>
            <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="6" Grid.Row="7" MouseDown="SelectTile"/>
        </Grid>
    </Grid>
</Window>
